{
  "name": "printer-monitor",
  "version": "0.3.0",
  "description": "Unified Klipper & Bambu Lab 3D printer monitor for Windows",
  "main": "./out/main/index.js",
  "author": "printer-monitor",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:server": "electron-vite dev -- --role=server",
    "dev:client": "electron-vite dev -- --role=client",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win",
    "dist:server": "npm run build && electron-builder --win -c.extraMetadata.hanyeAppRole=server -c.extraMetadata.productName=hanye-监控台服务端 -c.executableName=hanye-printer-server",
    "dist:client": "npm run build && electron-builder --win -c.extraMetadata.hanyeAppRole=client -c.extraMetadata.productName=hanye-监控台客户端 -c.executableName=hanye-printer-client",
    "sync:android": "powershell -NoProfile -ExecutionPolicy Bypass -File clients/android/sync-web.ps1",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.24.2",
    "axios": "^1.8.2",
    "basic-ftp": "^6.2.0",
    "dayjs": "^1.11.13",
    "fflate": "^0.8.3",
    "mqtt": "^5.15.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.printermonitor.app",
    "productName": "hanye-3D打印机监控台",
    "executableName": "hanye-printer-monitor",
    "artifactName": "hanye-printer-monitor-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "includeSubNodeModules": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "resources/runtime",
        "to": ".",
        "filter": [
          "*.dll"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "build/vc_redist.x64.exe",
        "to": "vc_redist.x64.exe"
      }
    ],
    "win": {
      "icon": "resources/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "unicode": true,
      "include": "build/installer.nsh",
      "artifactName": "hanye-printer-monitor-Setup-${version}.${ext}",
      "shortcutName": "hanye-3D打印机监控台",
      "uninstallDisplayName": "hanye-3D打印机监控台",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "hanye-printer-monitor-${version}-portable.exe"
    }
  }
}
